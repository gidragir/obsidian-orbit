{
  "name": "tabs-renderer",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gidragir/obsidian-tabs-renderer.git"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "tsx ../../scripts/build.ts",
    "dev": "tsx ../../scripts/build.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-html": "catalog:",
